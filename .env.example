# Public network configuration. Verify against official docs before deployment.
SOURCE_CHAIN_KEY=1
SOURCE_CHAIN_ID=11155111
SOURCE_CHAIN_RPC_URL=
CREDITCOIN_CHAIN_ID=102031
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
EVM_V1_DECODER_LIBRARY_ADDRESS=0x04B9ae8562D8Cc5bbbBbBB759080dDC30B56D18B

# Addresses populated after deployment.
SOURCE_LOAN_BOOK_ADDRESS=
EVIDENCE_REGISTRY_ADDRESS=
RESERVE_CONTROLLER_ADDRESS=
POOL_ADDRESS=
TEST_ASSET_ADDRESS=
EVIDENCE_DEPLOYMENT_BLOCK=

# Never commit keys. Prefer an encrypted Foundry keystore for deployments.
DEPLOYER_ACCOUNT=
# The TypeScript deployment scripts accept dedicated testnet-only keys.
SOURCE_DEPLOYER_PRIVATE_KEY=
CREDITCOIN_DEPLOYER_PRIVATE_KEY=
RISK_AGENT_ADDRESS=
# The unattended worker currently reads a test-only key from its process environment.
# Do not save a funded or production key in .env.
CREDITCOIN_WORKER_PRIVATE_KEY=
# Separate restricted signer accepted only by ReserveController.submitAssessment.
RISK_AGENT_PRIVATE_KEY=

SOURCE_CONFIRMATIONS=1
WORKER_STATE_PATH=.proofreserve/worker-state.json
CREDITCOIN_CONFIRMATIONS=1
SOURCE_DEPLOY_CONFIRMATIONS=1
CREDITCOIN_DEPLOY_CONFIRMATIONS=1

PORTFOLIO_LABEL=proofreserve-demo-v1
RESERVE_DECREASE_DELAY_SECONDS=86400
SOURCE_DEPLOYMENT_MANIFEST=deployments/sepolia.json
CREDITCOIN_DEPLOYMENT_MANIFEST=deployments/cc3-testnet.json

# Repeatable demo setup and the six-fact stress scenario.
# Leave DEMO_BORROWER_ADDRESSES empty to use the three deterministic demo addresses.
DEMO_BORROWER_ADDRESSES=
DEMO_GROUP_A_LABEL=proofreserve-group-a
DEMO_GROUP_B_LABEL=proofreserve-group-b
DEMO_POOL_SEED_TOKENS=100
DEMO_OBLIGATION_TOKENS=100
SETUP_MANIFEST=deployments/setup.json
SCENARIO_MANIFEST=deployments/scenario-epoch-1.json

# Hosted inference through the Gemini Developer API free tier.
# Keep this server-side and never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Browser-safe public dashboard configuration. Never use VITE_ for secrets.
VITE_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
VITE_EVIDENCE_REGISTRY_ADDRESS=
VITE_RESERVE_CONTROLLER_ADDRESS=
VITE_POOL_ADDRESS=
VITE_CONTROLLER_DEPLOYMENT_BLOCK=
VITE_LAST_CONFIDENCE_BPS=8500
VITE_CC3_EXPLORER_TX_URL=
